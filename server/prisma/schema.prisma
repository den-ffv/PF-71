generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  login    String @unique
  password String

  ProjectData  ProjectData[]
  ThoughtsData ThoughtsData[]

  @@map("user")
}

model HomeData {
  id      String @id @default(cuid())
  title   String
  content String

  ContactData ContactData[]

  @@map("home_data")
}

model ContactData {
  id           String   @id @default(cuid())
  title        String
  content      String
  home_data_id String
  home_data    HomeData @relation(fields: [home_data_id], references: [id], onDelete: Cascade)
  is_active    Boolean

  @@map("contact_data")
}

model ExperienceData {
  id         String   @id @default(cuid())
  title      String
  date_start DateTime
  date_end   DateTime
  content    String
  is_active  Boolean

  @@map("experience_data")
}

model ThoughtsData {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  content   String
  is_active Boolean
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("thoughts_data")
}

model ProjectData {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  content   String
  is_active Boolean
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("project_data")
}
